{% extends "boilerplate.template" %}

{% block head %}
  <link rel="stylesheet" href="/css/academy.css">
{% endblock %}

{% block body %}
  {% include "partials/navbar.template" %}

  <div class="container academy-course-page">
    <!-- Breadcrumb -->
    <div class="row bg-light">
      <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="/">Home</a></li>
        <li class="breadcrumb-item"><a href="/Academy/">Developer Academy</a></li>
        <li class="breadcrumb-item active">{{ title }}</li>
      </ol>
    </div>

    <!-- Course header band -->
    <div class="academy-course-header">
      <h1 class="academy-course-title">{{ title }}</h1>
      <div class="academy-course-pills">
        {% if duration %}<span class="badge academy-pill-duration">&#9201; {{ duration }}</span>{% endif %}
        {% if level %}<span class="badge academy-pill-level">{{ level }}</span>{% endif %}
        {% if tools %}<span class="badge academy-pill-tools">{{ tools }}</span>{% endif %}
        {% if is_stub %}
          <span class="badge academy-pill-status-soon">Coming Soon</span>
        {% else %}
          <span class="badge academy-pill-status-live">Live</span>
        {% endif %}
      </div>
    </div>

    {% if image_url %}
    <figure class="academy-course-figure academy-course-figure--{{ 'stub' if is_stub else 'live' }}">
      <img class="academy-course-image" src="{{ image_url }}" alt="{{ image_alt | e }}"
           width="{{ image_width }}" height="{{ image_height }}" decoding="async" fetchpriority="high">
    </figure>
    {% endif %}

    {% if is_stub %}
    <!-- Coming Soon state -->
    <div class="academy-stub-layout" data-academy-stub data-academy-page-status="coming-soon"
         data-tutorial-name="{{ analytics_tutorial_name | e }}" data-tutorial-slug="{{ analytics_tutorial_slug }}">
      <main class="academy-coming-soon">
        <p class="academy-stub-eyebrow">Tutorial preview</p>
        <p class="academy-stub-description">{{ current_tutorial.description }}</p>
        <p class="academy-stub-prerequisite"><strong>Before you start:</strong> {{ current_tutorial.prerequisite }}</p>
        <ul class="academy-stub-tags" aria-label="Technologies">
          {% for tag in current_tutorial.tags %}<li>{{ tag }}</li>{% endfor %}
        </ul>
        <p class="academy-stub-availability">{{ current_tutorial.availability }}</p>
        <a class="btn btn-primary academy-stub-notify"
           data-academy-notify
           data-tutorial-name="{{ analytics_tutorial_name | e }}"
           data-tutorial-slug="{{ analytics_tutorial_slug }}"
           href="https://www.yubico.com/email-subscription/?utm_source=developer-academy&amp;utm_medium=referral&amp;utm_campaign={{ current_tutorial.slug }}">Notify me when this tutorial launches</a>
        <div id="page-content" hidden><h2>Coming Soon</h2></div>
      </main>

      <aside class="academy-live-cross-sell" aria-labelledby="academy-live-heading">
        <h2 id="academy-live-heading">Explore a Live tutorial</h2>
        <ul>
          {% for tutorial in sidebar_entries if tutorial.status == 'live' %}
          <li><a href="{{ tutorial.url }}">{{ tutorial.title }}</a></li>
          {% endfor %}
        </ul>
      </aside>
    </div>

    {% else %}
    <!-- Live class state -->
    <div class="academy-live-layout" data-academy-page-status="live"
         data-tutorial-slug="{{ analytics_tutorial_slug }}"
         data-tutorial-name="{{ analytics_tutorial_name | e }}"
         data-canonical-url="{{ canonical_url }}"
         data-academy-tutorials="{{ academy_order | map(attribute='slug') | join('|') }}">
      <button type="button" class="academy-nav-toggle" data-academy-nav-toggle
              aria-expanded="false" aria-controls="academy-step-panel">
        Tutorial progress
      </button>
      <aside class="academy-sidebar" id="academy-step-panel" role="navigation" aria-label="Tutorial sections">
          <!-- Step navigator (JS-driven) -->
          <div class="academy-step-nav">
            <p class="academy-step-nav-label"><strong>In this tutorial</strong></p>
            <ol class="academy-step-list" id="academy-step-list">
              <!-- Populated by academy.js via IntersectionObserver -->
            </ol>
          </div>

          <hr>

          <!-- Class progression -->
          <div class="academy-class-list">
            <p class="academy-step-nav-label"><strong>In the Academy</strong></p>
            <ul class="list-unstyled">
              {% for tutorial in sidebar_entries %}
              <li class="academy-class-item academy-class-{{ tutorial.status }}"
                  data-tutorial-slug="{{ tutorial.slug }}"
                  {% if tutorial.slug == current_slug %}aria-current="page"{% endif %}>
                <a href="{{ tutorial.url }}">{{ tutorial.title }}</a>
                <span class="academy-class-status">{{ 'Live' if tutorial.status == 'live' else 'Coming Soon' }}</span>
              </li>
              {% endfor %}
            </ul>
          </div>
      </aside>

      <!-- Main content -->
      <main class="academy-course-content">
        {% if youtube_id %}
        <div class="academy-video">
          <iframe width="100%" style="aspect-ratio:16/9" src="https://www.youtube.com/embed/{{ youtube_id }}"
            title="Video for {{ title | e }}" loading="lazy" frameborder="0" allowfullscreen></iframe>
        </div>
        {% endif %}

        <div id="page-content">
          {{ content }}
        </div>

        <div class="academy-end-of-class">
          {% set share_url = canonical_url ~ '?utm_source=academy-share&utm_medium=social&utm_campaign=' ~ analytics_tutorial_slug %}
          <section class="academy-share-row" aria-labelledby="academy-share-heading">
            <h2 id="academy-share-heading">Share this tutorial</h2>
            <div class="academy-share-controls">
              <a data-academy-share="twitter" aria-label="Share on Twitter/X"
                 href="https://twitter.com/intent/tweet?url={{ share_url | urlencode }}&amp;text={{ analytics_tutorial_name | urlencode }}"
                 target="_blank" rel="noopener noreferrer">Twitter/X</a>
              <a data-academy-share="linkedin" aria-label="Share on LinkedIn"
                 href="https://www.linkedin.com/sharing/share-offsite/?url={{ share_url | urlencode }}"
                 target="_blank" rel="noopener noreferrer">LinkedIn</a>
              <a data-academy-share="bluesky" aria-label="Share on Bluesky"
                 href="https://bsky.app/intent/compose?text={{ analytics_tutorial_name | urlencode }}%20{{ share_url | urlencode }}"
                 target="_blank" rel="noopener noreferrer">Bluesky</a>
              <button type="button" data-academy-share="copy-link" data-academy-copy-link="{{ share_url }}"
                      aria-label="Copy link to this tutorial">Copy Link</button>
              <button type="button" data-academy-native-share aria-label="Share this tutorial">Share</button>
            </div>
            <span class="academy-share-status" role="status" aria-live="polite"></span>
          </section>
          <a class="academy-newsletter-cta"
             href="https://www.yubico.com/email-subscription/?utm_source=developer-academy&amp;utm_medium=referral&amp;utm_campaign=tutorial-complete">Notify me about new tutorials</a>
          <hr>
          <nav class="academy-prev-next" aria-label="Tutorial sequence">
            {% if prev_tutorial %}<a class="academy-previous" href="{{ prev_tutorial.url }}">&larr; {{ prev_tutorial.title }}</a>{% endif %}
            {% if next_tutorial %}<a class="academy-next" href="{{ next_tutorial.url }}">{{ next_tutorial.title }} &rarr;</a>{% endif %}
            {% if not next_tutorial %}<a class="academy-hub-return" href="/Academy/">Back to Developer Academy &rarr;</a>{% endif %}
          </nav>
        </div>
      </main>
    </div>
    {% endif %}
  </div>

  {% include "partials/footer.template" %}

  <script src="/js/academy.js"></script>
  <script src="/vendor/mermaid/mermaid.min.js"></script>
  <script>mermaid.initialize({ startOnLoad: true, theme: 'neutral' });</script>
{% endblock %}
