{% extends "boilerplate.template" %}

{% block head %}
  <link rel="stylesheet" href="/css/academy.css">
{% endblock %}

{% block body %}
  <nav class="navbar navbar-expand-lg navbar-top navbar-dark">
    <div class="container">
      <a class="navbar-brand" href="/" aria-label="Yubico Developers home"><img src="/logo.png" alt="Yubico Developers"></a>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarToggler" aria-controls="navbarToggler" aria-expanded="false" aria-label="Toggle navigation">
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="navbar-collapse collapse" id="navbarToggler">
        <ul class="navbar-nav me-auto mb-2 mb-lg-0">
          {% for sect in nav -%}
            {%- if sect.hidden -%}
            {%- elif sect.active -%}
              <li class="nav-item"><a class="nav-link active fw-bold" aria-current="page" href="{{ sect.url }}">{{ sect.name }}</a></li>
            {%- else -%}
              <li class="nav-item"><a class="nav-link fw-bold" href="{{ sect.url }}">{{ sect.name }}</a></li>
            {%- endif -%}
          {%- endfor %}
        </ul>
      </div>
    </div>
  </nav>

  <!-- Academy hero -->
  <div class="academy-hero">
    <div class="container">
      <h1 class="academy-hero-title">Yubico Developer Academy</h1>
      <p class="academy-hero-sub">Practical tutorials for building with FIDO2 and hardware security keys.</p>
      {% set live_tutorials = academy_order | selectattr('status', 'equalto', 'live') | list %}
      {% if live_tutorials %}
      <a href="{{ live_tutorials[0].url }}" class="btn btn-primary btn-lg academy-hero-cta">Start the first tutorial &rarr;</a>
      {% endif %}
    </div>
  </div>

  <div class="container academy-main">
    <section class="academy-discovery" aria-labelledby="academy-tutorials-heading">
      <h2 id="academy-tutorials-heading">Choose a tutorial</h2>
      <div class="academy-filters" aria-label="Filter tutorials by technology">
        <span class="academy-filter-label">Technology</span>
        <div class="academy-filter-controls">
          <button type="button" class="academy-filter is-selected" data-academy-filter="all" aria-pressed="true">All</button>
          {% for tag in active_tags %}
          <button type="button" class="academy-filter" data-academy-filter="{{ tag }}" aria-pressed="false">{{ tag }}</button>
          {% endfor %}
        </div>
      </div>

      <div class="academy-card-grid" data-academy-card-grid>
        {% for tutorial in academy_order %}
        <article class="academy-card academy-card--{{ tutorial.status }}"
                 data-academy-card
                 data-tutorial-slug="{{ tutorial.slug }}"
                 data-tutorial-tags="{{ tutorial.tags | join('|') }}">
          <div class="academy-card-header">
            <span class="academy-card-status">{{ 'Live' if tutorial.status == 'live' else 'Coming Soon' }}</span>
            <span class="academy-card-timing">{{ tutorial.duration if tutorial.status == 'live' else tutorial.availability }}</span>
          </div>
          <h3 class="academy-card-title"><a href="{{ tutorial.url }}">{{ tutorial.title }}</a></h3>
          <p class="academy-card-description">{{ tutorial.description }}</p>
          <p class="academy-card-prerequisite"><strong>Before you start:</strong> {{ tutorial.prerequisite }}</p>
          <ul class="academy-card-tags" aria-label="Technologies">
            {% for tag in tutorial.tags %}<li>{{ tag }}</li>{% endfor %}
          </ul>
          {% if tutorial.status == 'coming-soon' %}
          <a class="academy-card-notify"
             data-academy-notify
             data-tutorial-name="{{ tutorial.title | e }}"
             data-tutorial-slug="{{ tutorial.slug }}"
             href="https://www.yubico.com/newsletter/?utm_source=developer-academy&amp;utm_medium=referral&amp;utm_campaign={{ tutorial.slug }}">Notify me when this tutorial launches</a>
          {% endif %}
        </article>
        {% endfor %}
      </div>
      <p class="academy-filter-empty" data-academy-filter-empty hidden>No tutorials match this technology.</p>
    </section>

    <section class="academy-roles" aria-labelledby="academy-start-heading">
      <h2 id="academy-start-heading">Where to start</h2>
      <ul class="academy-start-list">
        {% for recommendation in where_to_start %}
        <li class="academy-start-item" data-tutorial-slug="{{ recommendation.slug }}">
          <span>{{ recommendation.prompt }}</span>
          <a href="{{ recommendation.url }}">{{ recommendation.title }}</a>
          {% if recommendation.status == 'coming-soon' %}<span class="academy-start-status">Coming Soon</span>{% endif %}
        </li>
        {% endfor %}
      </ul>
    </section>

    <div id="page-content" hidden>
      <h1>Developer Academy</h1>
    </div>

    <!-- Community -->
    <div class="academy-community">
      <h2>Community &amp; resources</h2>
      <ul>
        <li><a href="https://github.com/Yubico" target="_blank" rel="noopener">Yubico on GitHub</a></li>
        <li><a href="https://yubicolabs.github.io" target="_blank" rel="noopener">Yubico Labs</a></li>
        <li><a href="https://www.youtube.com/c/Yubico" target="_blank" rel="noopener">Yubicurious on YouTube</a></li>
      </ul>
    </div>


  </div>

  <footer class="container">
    <div class="row" style="margin-top:30px;padding-top:20px;border-top:1px solid #eee;">
      <div class="col-md-3">
        <p style="line-height:2em;font-size:90%">
          <strong><a href="https://developers.yubico.com/" style="color:#000">DEV.YUBICO</a></strong><br>
          {% for sect in nav -%}
            {%- if not sect.hidden %}
            <a href="{{ sect.url }}">{{ sect.name }}</a><br>
            {% endif -%}
          {%- endfor %}
        </p>
      </div>
      <div class="col-md-3">
        <p style="line-height:2em;font-size:90%"><strong>RESOURCES</strong><br>
          <a href="https://www.yubico.com/store/" target="_blank">Buy YubiKeys</a><br>
          <a href="https://www.yubico.com/blog/" target="_blank">Blog</a><br>
          <a href="https://www.yubico.com/newsletter/" target="_blank">Newsletter</a><br>
          <a href="https://forum.yubico.com/" target="_blank">Yubico Forum Archive</a></p>
      </div>
      <div class="col-md-3">
        <p style="line-height:2em;font-size:90%"><strong><a href="https://www.yubico.com/" style="color:#000" target="_blank">YUBICO.COM</a></strong><br>
          <a href="https://www.yubico.com/why-yubico/" target="_blank">Why Yubico</a><br>
          <a href="https://www.yubico.com/about/about-us/" target="_blank">About Yubico</a><br>
          <a href="https://www.yubico.com/support/terms-conditions/cookie-notice/" target="_blank">Cookie</a><br>
          <a href="https://www.yubico.com/support/terms-conditions/" target="_blank">Legal</a><br>
          <a href="https://www.yubico.com/support/terms-conditions/privacy-notice/" target="_blank">Privacy</a></p>
      </div>
    </div>
  </footer>
  <script src="/js/academy.js"></script>
{% endblock %}
